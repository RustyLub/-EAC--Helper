{
  "name": "eac-helper-discord-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bot": "tsx src/bot/main.ts",
    "dev": "tsx server.ts",
    "build:bot": "tsc --noEmit -p tsconfig.bot.json",
    "build:web": "npm run typecheck:web && vite build",
    "build": "npm run build:bot && npm run build:web",
    "start": "tsx server.ts",
    "lint": "npm run build:bot",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/bot/utils/*.test.ts\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
