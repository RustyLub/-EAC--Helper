# Discord Developer Portal -> Bot
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Discord Developer Portal -> General Information
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID

# Optional: your test server ID. Slash commands appear there immediately.
# If empty, commands are registered globally and may take time to appear.
GUILD_ID=

# Firebase Firestore is used by XP, levels, language, automod and welcome/leave features.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# Option A (recommended): path to your Firebase service-account JSON file.
# Example on Windows: C:\\EAC-Helper\\firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Option B: paste the full service-account JSON as a single line.
# FIREBASE_SERVICE_ACCOUNT=
