# Dashboard API URL
VITE_API_BASE_URL="https://eac-helper.onrender.com"

# Public URL of the deployed Node.js service, e.g. https://eac-helper.onrender.com
APP_URL="https://your-service.onrender.com"

# Discord Developer Portal > Bot
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# Discord Developer Portal > OAuth2
CLIENT_ID="YOUR_DISCORD_APPLICATION_ID"
CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"

# Firebase project settings
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
# Paste the complete Firebase service-account JSON on one line in production.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT_ID", "...":"..."}'

# Optional: register slash commands in one development server
GUILD_ID="YOUR_DISCORD_GUILD_ID"
