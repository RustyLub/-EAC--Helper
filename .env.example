# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID

# Optional: test server ID for instant guild command registration.
# Leave empty to register commands globally (propagation can take time).
GUILD_ID=

# Firebase Console -> Project settings -> General -> Project ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# Recommended: absolute path to the downloaded Firebase Admin service-account JSON.
# Windows example: C:/EAC-Helper/firebase-service-account.json
# The file must exist and contain project_id, client_email and private_key.
GOOGLE_APPLICATION_CREDENTIALS=

# Alternative to the JSON file path: paste the complete service-account JSON on one line.
# Keep this secret. Do not commit it or share it.
# FIREBASE_SERVICE_ACCOUNT=
