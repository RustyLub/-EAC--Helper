# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID

# Discord Developer Portal -> OAuth2 -> Client Secret
CLIENT_SECRET=YOUR_DISCORD_OAUTH_CLIENT_SECRET

# Public application origin. Local development:
APP_URL=http://localhost:3000

# Optional: test server ID for instant slash-command registration.
# Leave empty to register commands globally (propagation can take time).
GUILD_ID=
